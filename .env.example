# Application
APP_ENV=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database and infrastructure
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_USER=customer_service
RABBITMQ_PASSWORD=customer_service
DATABASE_URL=postgresql+asyncpg://customer_service:customer_service@localhost:15432/customer_service
REDIS_URL=redis://localhost:16379/0
SESSION_TTL_SECONDS=86400
# JSON list of proxy CIDRs; leave empty when clients connect directly.
TRUSTED_PROXY_CIDRS=[]
RATE_LIMIT_MESSAGE_USER=10
RATE_LIMIT_MESSAGE_IP=60
RATE_LIMIT_EVIDENCE_USER=12
RATE_LIMIT_EVIDENCE_IP=60
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_WINDOW_SECONDS=30
CIRCUIT_OPEN_SECONDS=30
EVENT_BACKEND=redis
AGENT_TASK_BACKEND=inline
RABBITMQ_URL=amqp://customer_service:customer_service@localhost:5672/
RABBITMQ_EXCHANGE=customer_service.commands
RABBITMQ_AGENT_QUEUE=agent.reply.q
RABBITMQ_PREFETCH_COUNT=2
RABBITMQ_PUBLISH_POLL_SECONDS=0.5
RABBITMQ_PUBLISH_MAX_ATTEMPTS=10
RABBITMQ_PUBLISH_LOCK_TIMEOUT_SECONDS=60
RABBITMQ_CONSUMER_MAX_ATTEMPTS=4
RABBITMQ_CONVERSATION_LOCK_TTL_SECONDS=180
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=customer-service
MINIO_SECURE=false

# Agent. Development defaults to mock to avoid accidental model charges.
AGENT_MODE=
KIMI_API_KEY=replace-me
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_TURNS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_HISTORY_MESSAGES=12
AGENT_HISTORY_MAX_TOKENS=2560
AGENT_CURRENT_MESSAGE_MAX_TOKENS=4096
SUPERVISOR_PLAN_MAX_TOKENS=1024
SUPERVISOR_RESPONSE_MAX_TOKENS=1024
# Redis会话短期上下文采用滑动TTL；86400秒即24小时。
CONVERSATION_MEMORY_TTL_SECONDS=86400
TOOL_TIMEOUT_SECONDS=8

# Order source: mock, postgres, or http.
ORDER_BACKEND=postgres
ORDER_OMS_BASE_URL=
ORDER_OMS_API_KEY=
ORDER_OMS_TIMEOUT_SECONDS=5
AFTER_SALES_UPLOAD_MAX_BYTES=8000000
AFTER_SALES_VIDEO_UPLOAD_MAX_BYTES=50000000
AFTER_SALES_MAX_EVIDENCE_FILES=6
# Required in production for the human-agent workbench API.
AFTER_SALES_ADMIN_TOKEN=
AFTER_SALES_WORKER_POLL_SECONDS=1
AFTER_SALES_OUTBOX_MAX_ATTEMPTS=5
EVIDENCE_ANALYSIS_ENABLED=true
EVIDENCE_ANALYSIS_TIMEOUT_SECONDS=90
EVIDENCE_ANALYSIS_PROMPT_VERSION=evidence-precheck-v1

# Knowledge RAG. bge runs BAAI/bge-small-zh-v1.5 locally on CPU.
EMBEDDING_MODE=bge
EMBEDDING_DIMENSIONS=512
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_WARMUP_ON_STARTUP=true
KNOWLEDGE_CHUNK_CHARS=900
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_UPLOAD_MAX_BYTES=2000000
KNOWLEDGE_BM25_K1=1.5
KNOWLEDGE_BM25_B=0.75
KNOWLEDGE_RRF_K=60
KNOWLEDGE_RETRIEVAL_CANDIDATES=20
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_CANDIDATE_LIMIT=10
# Calibrated on the policy-rag-v2 dataset; rerun after corpus/model changes.
RERANKER_THRESHOLD=0.04
RERANKER_WARMUP_ON_STARTUP=true
# Set this before exposing document upload outside local development.
KNOWLEDGE_ADMIN_TOKEN=

# Test/development only. Production uses Alembic.
AUTO_CREATE_SCHEMA=false
